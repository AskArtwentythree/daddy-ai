# Copy to .env. Every variable is optional; defaults run fully locally (no AWS).

DADDY_DATABASE_URL=postgresql://daddy:daddy@localhost:5433/daddy

# Storage for raw files and sent artifacts: local folder by default, S3 when a bucket is set.
DADDY_BLOB_DIR=data/blobs
# DADDY_S3_BUCKET=daddy-ai-artifacts

# Providers. Local defaults need no credentials; switch to bedrock once AWS keys exist.
DADDY_EMBEDDING_PROVIDER=hash        # hash | bedrock
DADDY_RERANK_PROVIDER=lexical        # lexical | bedrock
DADDY_LLM_PROVIDER=none              # none | bedrock | ollama

DADDY_AWS_REGION=us-west-2
# Verify model IDs and access in the Bedrock console for your region before switching.
# DADDY_BEDROCK_EMBEDDING_MODEL=cohere.embed-multilingual-v3
# DADDY_BEDROCK_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
# DADDY_BEDROCK_ANSWER_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# DADDY_BEDROCK_RERANK_MODEL_ARN=arn:aws:bedrock:us-west-2::foundation-model/cohere.rerank-v3-5:0
# DADDY_GUARDRAIL_ID=
# DADDY_GUARDRAIL_VERSION=DRAFT

# DADDY_OLLAMA_URL=http://localhost:11434
# DADDY_OLLAMA_MODEL=qwen3:14b

# Required to create the first family (workspace) when the server is reachable by others.
# DADDY_BOOTSTRAP_SECRET=
