# Daddy AI on AWS. On the EC2 instance:  cp deploy/.env.aws.example .env  then replace every CHANGE_ME.
# deploy/README.md says where to find each value. Never commit the filled-in .env or paste it into chat.
# There are no AWS keys here on purpose: the server uses the EC2 instance role.

# ── Server ────────────────────────────────────────────────────────────────────
DADDY_HOST=0.0.0.0
DADDY_PORT=8787

# Required because the server is public. Generate with:  openssl rand -hex 24
# Send it to Askar privately; he uses it once to create the family.
DADDY_BOOTSTRAP_SECRET=CHANGE_ME_BOOTSTRAP_SECRET

# ── Database: RDS PostgreSQL 17 (pgvector 0.8+) ───────────────────────────────
# URL-encode the password if it contains @ : / ? # % or spaces.
DADDY_DATABASE_URL=postgresql://CHANGE_ME_DB_USER:CHANGE_ME_DB_PASSWORD@CHANGE_ME_RDS_ENDPOINT:5432/CHANGE_ME_DB_NAME?sslmode=require

# ── Files: private S3 bucket with SSE-KMS default encryption ──────────────────
DADDY_S3_BUCKET=CHANGE_ME_BUCKET_NAME

# ── Region: the same one for Bedrock, S3 and RDS ──────────────────────────────
DADDY_AWS_REGION=CHANGE_ME_REGION

# ── Models (Bedrock) ──────────────────────────────────────────────────────────
# If Bedrock access isn't ready yet, set these three to hash / lexical / none to deploy without it.
DADDY_EMBEDDING_PROVIDER=bedrock
DADDY_RERANK_PROVIDER=bedrock
DADDY_LLM_PROVIDER=bedrock

# Keep these if they are enabled in your region. "us." profiles work in US regions only (EU uses "eu.").
DADDY_BEDROCK_EMBEDDING_MODEL=cohere.embed-multilingual-v3
DADDY_BEDROCK_FAST_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0
DADDY_BEDROCK_ANSWER_MODEL=us.anthropic.claude-sonnet-4-5-20250929-v1:0
# The region inside this ARN must match DADDY_AWS_REGION.
DADDY_BEDROCK_RERANK_MODEL_ARN=arn:aws:bedrock:CHANGE_ME_REGION::foundation-model/cohere.rerank-v3-5:0

# ── Guardrail (optional): uncomment both lines to enable ──────────────────────
# DADDY_GUARDRAIL_ID=CHANGE_ME_GUARDRAIL_ID
# DADDY_GUARDRAIL_VERSION=DRAFT
